{
  "name": "cf-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/providers/*",
    "packages/email-transports/*",
    "packages/policies/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit && tsc -p packages/core/tsconfig.json && tsc -p tests/types/tsconfig.json",
    "types:generate": "wrangler types --config apps/worker/wrangler.jsonc apps/worker/worker-configuration.d.ts --env-interface WorkerBindings",
    "types:check": "wrangler types --config apps/worker/wrangler.jsonc apps/worker/worker-configuration.d.ts --env-interface WorkerBindings --check",
    "test": "vitest run --config vitest.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "build": "wrangler deploy --config apps/worker/wrangler.jsonc --dry-run --outdir ../../dist/worker",
    "dev": "wrangler dev --config apps/worker/wrangler.jsonc --local",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:workers && npm run test:dlq && npm run types:check && npm run build",
    "test:dlq": "vitest run --config vitest.platform.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261010.1",
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha"
  }
}
